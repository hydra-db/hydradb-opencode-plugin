{
  "name": "hydradb-opencode-plugin",
  "version": "0.1.0",
  "description": "Persistent, cross-session memory for OpenCode, powered by HydraDB: prompt-time recall, workspace sync, and conversation capture.",
  "author": "HydraDB <support@hydradb.com>",
  "license": "Apache-2.0",
  "homepage": "https://docs.hydradb.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydra-db/hydradb-opencode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/hydra-db/hydradb-opencode-plugin/issues"
  },
  "keywords": [
    "hydradb",
    "memory",
    "retrieval",
    "opencode",
    "knowledge-base"
  ],
  "type": "module",
  "main": ".opencode/plugins/hydradb.js",
  "files": [
    ".opencode",
    "scripts",
    "hydradb-api-info",
    "opencode.json.example",
    "config.example.json",
    ".hydradb-plugin.json.example",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "devDependencies": {
    "@hydradb/sdk": "2.1.2",
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.31"
  }
}
